rules_version = '2';
// Visitors may only ADD anonymous, well-formed feedback events (place ids, step, time: no personal data).
// Nobody can edit or delete them from a browser. Counts are public so the review page can read them.
service cloud.firestore {
  match /databases/{database}/documents {
    function isId(v) { return v is string && v.matches('^[a-z0-9_]{1,64}$'); }

    match /feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['venue', 'kind', 'from', 'to', 'step', 'edge_from', 'edge_to', 'at'])
        && request.resource.data.keys().hasAll(['venue', 'kind', 'from', 'to', 'step', 'at'])
        && isId(request.resource.data.venue)
        && request.resource.data.kind in ['lost', 'arrived']
        && isId(request.resource.data.from) && isId(request.resource.data.to)
        && request.resource.data.step is int && request.resource.data.step >= 0 && request.resource.data.step < 1000
        && request.resource.data.at is timestamp && request.resource.data.at <= request.time + duration.value(5, 'm')
        && (!('edge_from' in request.resource.data) || isId(request.resource.data.edge_from))
        && (!('edge_to' in request.resource.data) || isId(request.resource.data.edge_to));
      allow update, delete: if false;
    }

    // Maps made with "Create a map": anyone can publish, nobody can edit or delete from a browser.
    match /maps/{mapId} {
      allow read: if true;
      allow create: if isId(mapId)
        && request.resource.data.keys().hasOnly(['name', 'map', 'places', 'created'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.map is string && request.resource.data.map.size() < 400000
        && request.resource.data.places is int && request.resource.data.places >= 2 && request.resource.data.places <= 200
        && request.resource.data.created is timestamp
        && request.resource.data.created > request.time - duration.value(5, 'm')
        && request.resource.data.created < request.time + duration.value(5, 'm');
      allow update, delete: if false;

      // One small JPEG per place, only within 30 minutes of publishing the map.
      match /photos/{placeId} {
        allow read: if true;
        allow create: if isId(placeId)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes && request.resource.data.data.size() < 400000
          && get(/databases/$(database)/documents/maps/$(mapId)).data.created > request.time - duration.value(30, 'm');
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
